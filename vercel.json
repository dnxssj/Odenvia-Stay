{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/odenvia-demo",
      "destination": "/index.html"
    },
    {
      "source": "/odenvia-demo/",
      "destination": "/index.html"
    },
    {
      "source": "/odenvia-demo/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/odenvia-demo/(.*)",
      "destination": "/index.html"
    }
  ]
}